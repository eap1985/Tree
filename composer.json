{
    "name": "eapcoder/tree",
    "description": "Safe, modern toolkit to build and render hierarchical category trees from a SQL table.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/var-dumper": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Tree\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tree\\Tests\\": "tests/"
        }
    }
}
